# Review / audit UI image for Fly.io (see fly.toml, `make fly-deploy-*`). Never contains data/sealed or data/raw.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 CODELOOP_DATA_DIR=/data PORT=8080
WORKDIR /repo
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY . .
RUN uv sync --frozen --no-dev
EXPOSE 8080
CMD ["/opt/venv/bin/codeloop", "serve"]
