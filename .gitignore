# environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.DS_Store

# raw downloads: deleted by `codeloop seal` / `codeloop ingest` after filtering; never committed
data/raw/*
!data/raw/.gitkeep

# normalized dev encounters are committed (ACI-Bench is CC BY 4.0) so the UI image carries them; `make data` rebuilds them

# traces are large and carry model output verbatim; predictions are committed
runs/**/traces/

# local caches and sqlite stores
*.sqlite
*.sqlite3
.cache/

# external table downloads and the built sqlite are rebuilt by `make tables`
data/tables/raw/
data/tables/*.building

# staging dir of `make fly-deploy-holdout` (sealed ciphertext copied for the image build, removed after)
.holdout-build/
.blog-build/
