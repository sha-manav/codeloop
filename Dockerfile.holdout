# Phase 9 holdout-labeling image (see fly.holdout.toml, `make fly-deploy-holdout`). Unlike Dockerfile.ui it carries the
# sealed holdout ciphertext, staged by the make target into .holdout-build/ (data/sealed itself stays dockerignored),
# and its entrypoint holds CODELOOP_SEAL_KEY. No predictions file is in the image. Destroy the app after the pull.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 CODELOOP_DATA_DIR=/data CODELOOP_HOLDOUT_SRC=/repo/holdout-seal PORT=8080
WORKDIR /repo
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY . .
COPY .holdout-build/ /repo/holdout-seal/
RUN uv sync --frozen --no-dev && rm -rf /repo/runs
EXPOSE 8080
CMD ["/opt/venv/bin/codeloop", "serve-holdout"]
